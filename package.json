{
  "name": "@panoptiorg/panoptife-ts",
  "version": "0.1.0",
  "description": "TypeScript/Svelte frontend for Panopticode: emits CGF (Code Graph Facts) from a SvelteKit-shaped repo",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "pc-fe-ts": "bin/pc-fe-ts"
  },
  "files": [
    "bin/",
    "dist/",
    "adapters/",
    "proto/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
